# Kopieren nach .env und ausfüllen:  cp .env.example .env
# Werte mit # (Farben, Hashtags) in Anführungszeichen, sonst liest Node sie als Kommentar.
# Mindestens eins von Telegram, Matrix oder Web-Version muss eingerichtet sein, alles andere ist optional.

# --- Telegram (optional) ---
# Token von @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram-IDs von Personen oder Gruppen, die den Bot benutzen dürfen (kommagetrennt, Gruppen-IDs sind negativ).
# Unbekannt? Dem Bot /id schreiben.
TELEGRAM_ERLAUBT=
# Leer = api.telegram.org (Videos nur bis 20 MB). Mit lokalem Bot-API-Server (bis 2 GB): http://localhost:8081
TELEGRAM_API_URL=

# --- Matrix (optional) ---
MATRIX_URL=https://matrix.piratenpartei.de
# Entweder Zugriffstoken des Bot-Kontos (Element → Einstellungen → Hilfe & Info → Zugriffstoken) …
MATRIX_TOKEN=
# … oder Benutzername und Passwort – der Bot meldet sich dann selbst an und merkt sich den Token in daten/matrix.json
MATRIX_NUTZER=
MATRIX_PASSWORT=
# Wer darf? Matrix-IDs (@name:piratenpartei.de), Räume (!abc:piratenpartei.de) oder ganze Server (*:piratenpartei.de)
MATRIX_ERLAUBT=
# Einladungen erlaubter Personen automatisch annehmen (ja/nein)
MATRIX_EINLADUNGEN_ANNEHMEN=ja

# --- Web-Version (optional) ---
# Port, auf dem die Web-Version läuft – leer = keine Web-Version
WEB_PORT=
# Nur lokal lauschen und einen Reverse-Proxy (nginx, Caddy) mit HTTPS davor – siehe README
WEB_ADRESSE=127.0.0.1
# Öffentliche Adresse, wird im Bot verlinkt, z. B. https://posting.piraten-nuernberg.de
WEB_URL=
# Anmeldung: ein gemeinsames Team-Passwort …
WEB_PASSWORT=
# … und/oder mit dem eigenen Matrix-Konto (Server: WEB_MATRIX_URL, sonst MATRIX_URL)
WEB_MATRIX_ANMELDUNG=nein
WEB_MATRIX_URL=https://matrix.piratenpartei.de
# Wer sich per Matrix anmelden darf: @name:server oder ganze Server (*:piratenpartei.de)
WEB_ERLAUBT=
# Wer im Browser über Postiz posten darf: nein, ja (alle Angemeldeten) oder eine Liste wie WEB_ERLAUBT
WEB_POSTEN=nein
# Größte Datei zum Hochladen in MB
WEB_MAX_MB=500
# Ohne jede Anmeldung nur mit WEB_OFFEN=ja – ausschließlich im eigenen Netz!
WEB_OFFEN=nein

# --- ppicng (Design) ---
# ppicng liegt als Git-Submodul in ppicng/ – Logos, Schriften und Farben kommen von dort.
# Eigener Checkout (z. B. mit zusätzlichen Logos eurer Gliederung): Pfad hier eintragen.
PPICNG_DIR=ppicng
# Adresse eurer ppicng-Web-App – wird im Bot verlinkt (z. B. für eigene Titelkarten), leer = kein Link
PPICNG_URL=

# --- Voreinstellungen für neue Beiträge (je Chat/Raum überschreibbar in chats.json) ---
# weiss-schwarz-orange, schwarz-weiss-orange, orange-weiss-lila, lila-weiss-orange, weiss-schwarz-lila
DESIGN=weiss-schwarz-orange
# Logo-ID aus ppicng (Gruppe/Name), z. B. common/piraten, laender/bayern, regional/leipzig, jupi/jupi1.
# Suchen: /logo Bayern im Bot. „kein“ = ohne Logo.
LOGO=common/piraten
# plakette = Logo auf einer Fläche im Design mit Linie; frei = nur das helle Logo mit Schatten
LOGO_STIL=plakette
# oben-links, oben-rechts, unten-links, unten-rechts
LOGO_POSITION=oben-links
# Logobreite als Anteil der kurzen Bildseite
LOGO_BREITE=0.36
# Wer postet? Für die KI-Texte, z. B. „die PIRATEN Nürnberg“
ABSENDER=die Piratenpartei

# --- Video ---
# original, 9:16, 4:5, 1:1, 16:9
VIDEO_FORMAT=original
# Passt das Video nicht genau ins Format: rand = mit unscharfer Kopie auffüllen, zuschneiden = Überstand weg
VIDEO_ANPASSEN=rand
# Untertitel automatisch, wenn Whisper eingerichtet ist (ja/nein)
UNTERTITEL_STANDARD=ja
# box = Textfläche im Design (wie die Textflächen in ppicng), rand = weiße Schrift mit schwarzer Kontur
UNTERTITEL_STIL=box
# Bauchbinde mit Name und Funktion – pro Video im Menü zuschaltbar, auch mit anderem Namen
BAUCHBINDE_NAME=
BAUCHBINDE_FUNKTION=
# ja = bei jedem Video automatisch an
BAUCHBINDE_STANDARD=nein
# Sekunden nach Beginn und wie lange
BAUCHBINDE_START=0.6
BAUCHBINDE_DAUER=4.5
# Titelkarte vor dem Video (Text pro Video im Menü) und Abspann danach
TITELKARTE_DAUER=2.5
ABSPANN_STANDARD=nein
ABSPANN_TEXT=piratenpartei.de
ABSPANN_DAUER=3
# libx264 (überall) oder h264_v4l2m2m (Hardware-Encoder Raspberry Pi 4)
VIDEO_ENCODER=libx264
VIDEO_PRESET=veryfast
VIDEO_CRF=21

# --- Sharepics ---
# 1:1, 4:5, 9:16, 16:9
SHAREPIC_FORMAT=1:1

# --- Spracherkennung für Untertitel (optional, whisper.cpp) ---
# Leer = keine automatischen Untertitel (eine .srt-Datei kann man trotzdem schicken)
WHISPER_MODELL=
WHISPER_BIN=/home/pi/whisper.cpp/build/bin/whisper-cli
WHISPER_THREADS=4
WHISPER_SPRACHE=de
GLOSSAR=glossar.txt

# --- Gesichtssuche für die Untertitel (optional) ---
# Hochkant sucht der Bot das Gesicht (OpenCV, lokal) und legt die Untertitel so, dass sie es nicht verdecken.
# Python mit OpenCV, das pi/install.sh in .venv anlegt. Fehlt es, bleibt die Suche aus.
GESICHT_PYTHON=.venv/bin/python

# --- Postiz (optional) ---
# Ohne Postiz gibt es die fertige Datei zum Herunterladen („📥 Fertige Datei“).
# Adresse der Postiz-Instanz, mit oder ohne /api, z. B. http://localhost:5000 oder https://postiz.example.de
POSTIZ_URL=
# Postiz → Einstellungen → Developers → Public API
POSTIZ_API_KEY=
# Kunde, der standardmäßig gewählt ist (Name oder ID aus /kanaele). Leer = alle Kanäle.
POSTIZ_KUNDE=
# Kanäle, die standardmäßig angehakt sind: Name, @Handle oder ID, kommagetrennt. Leer = alle des Kunden.
POSTIZ_KANAELE=
# Postiz erlaubt standardmäßig 30 API-Anfragen pro Stunde. Der Bot zählt mit. 0 = nicht mitzählen.
POSTIZ_MAX_ANFRAGEN=28
# Eigene Einstellungen je Netzwerk/Kanal (siehe kanaele.example.json)
KANAL_EINSTELLUNGEN=kanaele.json

# --- Beitragstexte per KI (optional) ---
# Ohne Schlüssel: einfacher Vorschlag (Transkript-Auszug bzw. Claim + Hashtags).
# Mit Schlüssel gehen Transkript, Sharepic-Text bzw. Foto an den Anbieter (nicht lokal).
# claude oder openai – leer = automatisch der, für den ein Schlüssel eingetragen ist
CAPTION_ANBIETER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: OpenAI-kompatible Adresse, z. B. ein lokales Modell über Ollama (http://localhost:11434/v1)
OPENAI_BASE_URL=
# Leer = claude-opus-5-5 bzw. gpt-5.5
CAPTION_MODELL=
CAPTION_STIL=
CAPTION_HASHTAGS="#Piraten"

# --- Sonstiges ---
# Eigene Voreinstellungen je Chat/Raum (siehe chats.example.json)
CHATS=chats.json
# Fertige Dateien zusätzlich hierhin kopieren, z. B. in einen Nextcloud-Ordner (leer = nicht)
AUSGABE_ORDNER=
ZEITZONE=Europe/Berlin
DATEN_DIR=daten
